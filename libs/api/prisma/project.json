{
  "name": "api-prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/prisma/src",
  "projectType": "library",
  "tags": [
    "scope:api",
    "type:data-access"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/api/prisma",
        "tsConfig": "libs/api/prisma/tsconfig.lib.json",
        "packageJson": "libs/api/prisma/package.json",
        "main": "libs/api/prisma/src/index.ts",
        "assets": [
          "libs/api/prisma/*.md",
          {
            "input": "libs/api/prisma/prisma",
            "glob": "**/*",
            "output": "prisma"
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/api/prisma",
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts",
        {
          "externalDependencies": [
            "prisma",
            "@prisma/client"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "options": {
        "cwd": "libs/api/prisma",
        "command": "prisma generate"
      }
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/api/prisma",
        "command": "prisma migrate dev"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/api/prisma",
        "command": "prisma migrate deploy"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/api/prisma",
        "command": "prisma migrate status"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/api/prisma",
        "command": "prisma db seed"
      }
    }
  }
}
