{
  "name": "api-trial",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/trial/src",
  "projectType": "library",
  "tags": ["scope:api", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/trial",
        "tsConfig": "libs/api/trial/tsconfig.lib.json",
        "packageJson": "libs/api/trial/package.json",
        "main": "libs/api/trial/src/index.ts",
        "assets": ["libs/api/trial/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/api/trial",
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
