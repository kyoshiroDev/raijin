{
  "name": "bench-solana",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bench/solana/src",
  "projectType": "library",
  "tags": [
    "scope:bench",
    "type:data-access"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/bench/solana",
        "main": "libs/bench/solana/src/index.ts",
        "tsConfig": "libs/bench/solana/tsconfig.lib.json",
        "assets": [
          "libs/bench/solana/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/bench/solana",
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
