{
  "name": "bench-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bench/core/src",
  "projectType": "library",
  "tags": ["scope:bench", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/bench/core",
        "main": "libs/bench/core/src/index.ts",
        "tsConfig": "libs/bench/core/tsconfig.lib.json",
        "assets": ["libs/bench/core/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/bench/core",
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "parallel": false
      }
    }
  }
}
