// Schéma de la base du banc `raijin_bench` (docs/ARCHITECTURE.md §17, inventaire docs/BENCH.md §4).
// Client généré par : pnpm nx run bench-prisma:prisma-generate (src/generated/, ignoré par Git), sortie
// distincte de api-prisma. Migrations SQL versionnées dans prisma/migrations (bench-prisma:migrate-deploy),
// exécutées par l'utilisateur Postgres `raijin_bench` seul.
//
// Ce fichier est le REFLET des migrations (`prisma db pull`), pas leur source : les tables portées
// viennent du rejeu des migrations Supabase (README.md, « Origine du schéma »). Contraintes CHECK,
// contrainte NOT VALID, déclencheurs, fonctions SQL et schémas `archive` / `shadow_ref` vivent
// uniquement dans le SQL des migrations ; `prisma migrate diff --from-config-datasource --to-schema`
// doit rester vide (vérifié par libs/bench/prisma/scripts/check-drift.sh).
// Noms snake_case identiques aux tables Supabase (même SQL dans les services portés, contrats du front).
// Compte unique : `user_id` = bench_owner.id (fonction SQL public.bench_owner_id(), P2).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model alert_log {
  id                  BigInt            @id @default(autoincrement())
  user_id             String            @db.Uuid
  mint                String
  notification_id     String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                String            @default("single")
  sent_at             DateTime          @default(now()) @db.Timestamptz(6)
  entry_price         Decimal?          @db.Decimal
  target_price        Decimal?          @db.Decimal
  stop_price          Decimal?          @db.Decimal
  rr                  Decimal?          @db.Decimal
  entry_roundtrip_pct Decimal?          @db.Decimal
  stake_sol           Decimal?          @db.Decimal
  max_price           Decimal?          @db.Decimal
  min_price           Decimal?          @db.Decimal
  last_price          Decimal?          @db.Decimal
  last_price_at       DateTime?         @db.Timestamptz(6)
  first_hit           String?
  first_hit_at        DateTime?         @db.Timestamptz(6)
  followup_sent_at    DateTime?         @db.Timestamptz(6)
  tracking_until      DateTime?         @db.Timestamptz(6)
  preset              String?
  bench_owner         bench_owner       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  paper_positions     paper_positions[]

  @@index([sent_at], map: "alert_log_sent_idx")
  @@index([tracking_until(sort: Desc)], map: "alert_log_tracking_idx", where: raw("(tracking_until IS NOT NULL)"))
  @@index([user_id, mint, sent_at(sort: Desc)], map: "alert_log_user_mint_sent_idx")
  @@index([user_id, sent_at(sort: Desc)], map: "alert_log_user_sent_idx")
  @@index([user_id, sent_at(sort: Desc)], map: "alert_log_young_user_sent_idx", where: raw("(preset = 'young_strong'::text)"))
}

model alert_settings {
  user_id            String      @id @default(dbgenerated("bench_owner_id()")) @db.Uuid
  enabled            Boolean     @default(false)
  hide_bonding_curve Boolean     @default(true)
  quiet_start        Int         @default(23) @db.SmallInt
  quiet_end          Int         @default(7) @db.SmallInt
  max_per_hour       Int         @default(4) @db.SmallInt
  updated_at         DateTime    @default(now()) @db.Timestamptz(6)
  stake_sol          Decimal     @default(0.05) @db.Decimal
  auto_paper         Boolean     @default(false)
  paper_sl_pct       Decimal     @default(30) @db.Decimal
  alert_preset       String      @default("young_calm")
  max_per_day        Int         @default(30) @db.SmallInt
  bench_owner        bench_owner @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "alert_settings_enabled_idx", where: raw("enabled"))
}

model backtest_event_state {
  key          String    @id
  state        Json
  locked_until DateTime? @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([updated_at], map: "backtest_event_state_updated_idx")
}

model backtest_events {
  id                BigInt    @id @default(autoincrement())
  preset            String
  mint              String
  pool              String
  event_at          DateTime  @db.Timestamptz(6)
  entry_snapshot_id BigInt
  price_at_event    Decimal   @db.Decimal
  mc                Decimal?  @db.Decimal
  liquidity         Decimal?  @db.Decimal
  narrative         String?
  pair_age_h        Float?    @db.Real
  roundtrip_known   Boolean
  roundtrip_pct     Decimal?  @db.Decimal
  conditions        Json      @default("{}")
  candles_1m_at     DateTime? @db.Timestamptz(6)
  candles_5m_at     DateTime? @db.Timestamptz(6)
  candles_attempts  Int       @default(0) @db.SmallInt
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([preset, mint])
  @@index([candles_1m_at], map: "backtest_events_candles_1m_idx", where: raw("(candles_1m_at IS NOT NULL)"))
  @@index([candles_5m_at], map: "backtest_events_candles_5m_idx", where: raw("(candles_5m_at IS NOT NULL)"))
  @@index([event_at])
}

model backtest_results {
  run_id              BigInt
  preset              String
  exit                String
  sl_pct              Int           @db.SmallInt
  breakeven           Boolean
  time_exit_h         Int           @db.SmallInt
  delay_min           Int           @db.SmallInt
  narrative           String
  split               String
  trades              Int
  win_rate            Float?        @db.Real
  avg_win_pct         Float?        @db.Real
  avg_loss_pct        Float?        @db.Real
  avg_net_pct         Float?        @db.Real
  avg_net_sol         Float?        @db.Real
  profit_factor       Float?        @db.Real
  max_drawdown_sol    Float?        @db.Real
  worst_losing_streak Int?
  ci_low              Float?        @db.Real
  ci_high             Float?        @db.Real
  ci_contains_zero    Boolean?
  open_at_end         Int           @default(0)
  retained            Boolean       @default(false)
  robust              Boolean       @default(false)
  exploratory         Boolean?      @default(dbgenerated("(preset = ANY (ARRAY['momentum_explo'::text, 'young_24h_explo'::text, 'young_3h_explo'::text]))"))
  backtest_runs       backtest_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, preset, exit, sl_pct, breakeven, time_exit_h, delay_min, narrative, split])
  @@index([run_id, narrative, split, avg_net_pct(sort: Desc)], map: "backtest_results_run_rank_idx", where: raw("retained"))
}

model backtest_runs {
  id                  BigInt             @id @default(autoincrement())
  status              String             @default("queued")
  requested_by        String?            @db.Uuid
  trigger             String
  params              Json               @default("{}")
  data_version        Json?
  n_detections        Int?
  n_variants          Int?
  n_distinct_variants Int?
  progress            Decimal            @default(0) @db.Decimal
  cursor              Json?
  locked_until        DateTime?          @db.Timestamptz(6)
  error               String?
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  started_at          DateTime?          @db.Timestamptz(6)
  finished_at         DateTime?          @db.Timestamptz(6)
  summary             Json?
  backtest_results    backtest_results[]
  bench_owner         bench_owner?       @relation(fields: [requested_by], references: [id], onUpdate: NoAction)
  backtest_trades     backtest_trades[]

  @@index([created_at], map: "backtest_runs_active_idx", where: raw("(status = ANY (ARRAY['queued'::text, 'running'::text]))"))
  @@index([created_at(sort: Desc)], map: "backtest_runs_created_idx")
}

model backtest_trades {
  run_id        BigInt
  source        String
  mint          String
  detected_at   DateTime      @db.Timestamptz(6)
  split         String
  preset_flags  Int           @db.SmallInt
  narrative     String
  returns       Float[]       @db.Real
  open_at_end   String?
  backtest_runs backtest_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, source, mint, detected_at, preset_flags])
  @@index([run_id, detected_at], map: "backtest_trades_run_detected_idx")
}

/// Compte unique du banc (BENCH_OWNER_EMAIL) : remplace auth.users. Une seule ligne (singleton). Mot de passe argon2id posé par la CLI.
model bench_owner {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton            Boolean                @unique @default(true)
  email                String
  password_hash        String?
  password_changed_at  DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  alert_log            alert_log[]
  alert_settings       alert_settings?
  backtest_runs        backtest_runs[]
  bench_owner_totp     bench_owner_totp?
  bench_recovery_codes bench_recovery_codes[]
  bench_sessions       bench_sessions[]
  paper_legs           paper_legs[]
  paper_positions      paper_positions[]
  paper_wallets        paper_wallets[]
  push_subscriptions   push_subscriptions[]
}

/// Secret TOTP chiffré (secret-box, clé propre au banc), jamais en clair. Posé par la CLI enroll-totp.
model bench_owner_totp {
  owner_id         String      @id @db.Uuid
  secret_encrypted String
  enabled_at       DateTime?   @db.Timestamptz(6)
  last_used_step   Int?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @default(now()) @db.Timestamptz(6)
  bench_owner      bench_owner @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Codes de secours à usage unique, hachés.
model bench_recovery_codes {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String      @db.Uuid
  code_hash   String      @unique
  used_at     DateTime?   @db.Timestamptz(6)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  bench_owner bench_owner @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "bench_recovery_codes_owner_idx")
}

/// Sessions du propriétaire : jeton haché, 2 h d'inactivité, 12 h au plus (CHECK).
model bench_sessions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id       String      @db.Uuid
  token_hash     String      @unique
  user_agent     String?
  ip_hash        String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  last_seen_at   DateTime    @default(now()) @db.Timestamptz(6)
  expires_at     DateTime    @db.Timestamptz(6)
  revoked_at     DateTime?   @db.Timestamptz(6)
  revoked_reason String?
  bench_owner    bench_owner @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "bench_sessions_expires_idx")
  @@index([owner_id], map: "bench_sessions_owner_idx")
}

/// État interne clé → valeur (niveau d'alerte de stockage, curseurs). Jamais de secret.
model bench_state {
  key        String   @id
  value      Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Agrégats quotidiens conservés sans limite (§16.5), calculés avant la purge.
model daily_verdict_metrics {
  day            DateTime @db.Date
  engine_version String
  horizon        String
  verdict        String
  outcome_status String
  n              Int
  signal_counts  Json     @default("{}")
  computed_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([day, engine_version, horizon, verdict, outcome_status])
  @@index([engine_version, day], map: "daily_verdict_metrics_engine_day_idx")
}

model early_buyers {
  mint               String
  wallet             String
  ts                 DateTime?          @db.Timestamptz(6)
  sol_amount         Decimal?           @db.Decimal
  rank               Int                @db.SmallInt
  slot               BigInt
  signature          String
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  wallet_study_state wallet_study_state @relation(fields: [mint], references: [mint], onDelete: Cascade, onUpdate: NoAction)

  @@id([mint, wallet])
  @@unique([mint, rank])
  @@index([wallet])
}

/// Variante du moteur testée derrière le drapeau `enabled` (§16.4) ; `reference` réservé.
model engine_variants {
  id              String            @id
  label           String
  overrides       Json              @default("{}")
  reason_weights  Json?
  fingerprint     String
  enabled         Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  variant_replays variant_replays[]
}

/// Observation de suivi à 24 h / 72 h / 7 j (§16.1), unique par (record_id, horizon).
model follow_up_observations {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  record_id       String          @db.Uuid
  horizon         String
  observed_at     DateTime        @db.Timestamptz(6)
  pool_found      Boolean?
  lp_removed      Boolean?
  price_usd       Decimal?        @db.Decimal
  liquidity_usd   Decimal?        @db.Decimal
  volume_24h_usd  Decimal?        @db.Decimal
  supply_raw      Decimal?        @db.Decimal(20, 0)
  status          String?
  events          String[]        @default([])
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  verdict_records verdict_records @relation(fields: [record_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([record_id, horizon], map: "follow_up_observations_record_horizon_key")
  @@index([observed_at], map: "follow_up_observations_observed_idx")
}

/// Journal des jobs BullMQ (une ligne par exécution ; chevauchement refusé = skipped).
model job_runs {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job         String
  status      job_run_status @default(running)
  started_at  DateTime       @default(now()) @db.Timestamptz(6)
  finished_at DateTime?      @db.Timestamptz(6)
  duration_ms Int?
  error       String?
  details     Json?

  @@index([job, started_at(sort: Desc)], map: "job_runs_job_started_idx")
  @@index([job], map: "job_runs_running_idx", where: raw("(status = 'running'::job_run_status)"))
  @@index([started_at], map: "job_runs_started_idx")
}

model label_runs {
  id           BigInt   @id @default(autoincrement())
  at           DateTime @default(now()) @db.Timestamptz(6)
  requests     Int      @db.SmallInt
  rate_limited Int      @db.SmallInt
  rows_written Int      @db.SmallInt
  labels       Int      @db.SmallInt
  candles      Int      @db.SmallInt
  failed       Int      @db.SmallInt
  queued       Int      @db.SmallInt
  ms           Int

  @@index([at])
}

/// Bougies compactes (tableaux real[] : une ligne par détection et unité de temps).
model ohlcv_candles {
  id          BigInt   @id @default(autoincrement())
  mint        String
  pool        String
  tf          String
  ts_start    DateTime @db.Timestamptz(6)
  step_s      Int
  ts          Int[]
  o           Float[]  @db.Real
  h           Float[]  @db.Real
  l           Float[]  @db.Real
  c           Float[]  @db.Real
  v           Float[]  @db.Real
  source      String
  detected_at DateTime @db.Timestamptz(6)
  fetched_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([mint, tf, ts_start], map: "ohlcv_candles_mint_tf_start_key")
  @@index([detected_at], map: "ohlcv_candles_detected_idx")
  @@index([fetched_at], map: "ohlcv_candles_fetched_idx")
}

model paper_legs {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position_id     String          @db.Uuid
  user_id         String          @db.Uuid
  size_pct        Int             @db.SmallInt
  tp_price        Decimal         @db.Decimal
  stop_price      Decimal         @db.Decimal
  status          String          @default("open")
  exit_price      Decimal?        @db.Decimal
  closed_at       DateTime?       @db.Timestamptz(6)
  paper_positions paper_positions @relation(fields: [position_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction, map: "paper_legs_position_fkey")
  bench_owner     bench_owner     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([position_id], map: "paper_legs_position_idx")
  @@index([user_id], map: "paper_legs_user_idx")
  @@index([user_id, closed_at(sort: Desc)], map: "paper_legs_user_sl_closed_idx", where: raw("(status = 'sl_hit'::text)"))
}

/// Positions paper v2 ; uniques partielles et déclencheur paper_positions_before_insert en SQL (P5).
model paper_positions {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String       @default(dbgenerated("bench_owner_id()")) @db.Uuid
  book               String       @default("main")
  mint               String
  symbol             String
  strategy           String
  stake_sol          Decimal      @db.Decimal
  source             String       @default("manual")
  alert_id           BigInt?
  status             String       @default("pending")
  entry_target_price Decimal      @db.Decimal
  fill_price         Decimal?     @db.Decimal
  sl_price           Decimal      @db.Decimal
  custom_tp_price    Decimal?     @db.Decimal
  sl_pct             Decimal      @default(30) @db.Decimal
  expires_at         DateTime     @db.Timestamptz(6)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  filled_at          DateTime?    @db.Timestamptz(6)
  closed_at          DateTime?    @db.Timestamptz(6)
  pnl_sol            Decimal?     @db.Decimal
  fees_sol           Decimal?     @db.Decimal
  entry_mode         String       @default("target")
  cancel_reason      String?
  paper_legs         paper_legs[]
  alert_log          alert_log?   @relation(fields: [alert_id], references: [id], onUpdate: NoAction)
  bench_owner        bench_owner  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, book, mint], map: "paper_positions_calm_frenzy_once_idx", where: raw("(book = ANY (ARRAY['calm_all_x2'::text, 'frenzy_all_x2'::text]))"))
  @@unique([id, user_id], map: "paper_positions_id_user_key")
  @@unique([user_id, book, mint], map: "paper_positions_test_books_active_idx", where: raw("((book = ANY (ARRAY['calm_sl30'::text, 'calm_sl40'::text, 'frenzy_sl30'::text])) AND (status = ANY (ARRAY['pending'::text, 'open'::text])))"))
  @@index([created_at], map: "paper_positions_active_idx", where: raw("(status = ANY (ARRAY['pending'::text, 'open'::text]))"))
  @@index([mint], map: "paper_positions_active_mint_idx", where: raw("(status = ANY (ARRAY['pending'::text, 'open'::text]))"))
  @@index([alert_id], map: "paper_positions_alert_idx", where: raw("(alert_id IS NOT NULL)"))
  @@index([book, status], where: raw("(status = ANY (ARRAY['pending'::text, 'open'::text]))"))
  @@index([user_id, book, status], map: "paper_positions_user_book_status_idx")
  @@index([user_id, created_at(sort: Desc)], map: "paper_positions_user_created_idx")
}

model paper_wallets {
  user_id     String      @default(dbgenerated("bench_owner_id()")) @db.Uuid
  balance_sol Decimal     @default(1.0) @db.Decimal
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  reset_at    DateTime?   @db.Timestamptz(6)
  book        String      @default("main")
  initial_sol Decimal     @default(1.0) @db.Decimal
  bench_owner bench_owner @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, book])
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
/// Détections par preset (dont presets archivés, en lecture) ; déclencheurs de points de contrôle en SQL.
model preset_signals {
  id                  BigInt    @id @default(autoincrement())
  preset              String
  mint                String
  pair_address        String
  detected_at         DateTime  @db.Timestamptz(6)
  entry_price         Decimal   @db.Decimal
  entry_mc            Decimal?  @db.Decimal
  entry_liq_eff       Decimal?  @db.Decimal
  entry_zone          String?
  entry_dex_id        String?
  entry_change_1h     Decimal?  @db.Decimal
  entry_roundtrip_pct Decimal?  @db.Decimal
  status              String    @default("pending")
  hit_x2              Boolean?
  hit_x3              Boolean?
  hit_x5              Boolean?
  dd50_first          Boolean?
  max_multiple_7d     Decimal?  @db.Decimal
  hours_to_x3         Decimal?  @db.Decimal
  hit_sl30            Boolean?
  x2_before_sl30      Boolean?
  sl30_before_x2      Boolean?
  min_multiple_7d     Decimal?  @db.Decimal
  hours_to_x2         Decimal?  @db.Decimal
  observed_hours      Decimal?  @db.Decimal
  labelled_at         DateTime? @db.Timestamptz(6)
  label_attempts      Int       @default(0) @db.SmallInt
  label_error         String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  next_label_at       DateTime? @db.Timestamptz(6)
  narrative           String?
  pair_age_h          Decimal?  @db.Decimal
  candles_1m_at       DateTime? @db.Timestamptz(6)
  candles_5m_at       DateTime? @db.Timestamptz(6)
  candles_attempts    Int       @default(0) @db.SmallInt

  @@unique([preset, mint])
  @@index([candles_1m_at], map: "preset_signals_candles_1m_idx", where: raw("(candles_1m_at IS NOT NULL)"))
  @@index([candles_5m_at], map: "preset_signals_candles_5m_idx", where: raw("(candles_5m_at IS NOT NULL)"))
  @@index([next_label_at], map: "preset_signals_next_label_idx", where: raw("(status = 'pending'::text)"))
  @@index([labelled_at, detected_at], map: "preset_signals_pending_queue_idx", where: raw("(status = 'pending'::text)"))
  @@index([preset, detected_at(sort: Desc)], map: "preset_signals_preset_detected_idx")
  @@index([status, detected_at(sort: Desc)], map: "preset_signals_status_detected_idx")
}

model push_subscriptions {
  id          BigInt      @id @default(autoincrement())
  user_id     String      @default(dbgenerated("bench_owner_id()")) @db.Uuid
  endpoint    String      @unique
  p256dh      String
  auth        String
  user_agent  String?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  bench_owner bench_owner @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "push_subscriptions_user_id_idx")
}

model scan_runs {
  id            BigInt    @id @default(autoincrement())
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  tokens_seen   Int       @default(0)
  tokens_kept   Int       @default(0)
  error         String?
  source_counts Json?
  sol_usd       Decimal?  @db.Decimal
  eur_usd       Decimal?  @db.Decimal

  @@index([started_at(sort: Desc)])
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
/// Issues des détections (étiquettes 7 j) ; déclencheurs de points de contrôle en SQL (P5).
model signal_outcomes {
  mint                String    @id
  pair_address        String
  source              String    @default("scan")
  detected_at         DateTime  @db.Timestamptz(6)
  entry_price         Decimal   @db.Decimal
  entry_mc            Decimal?  @db.Decimal
  entry_liq_eff       Decimal?  @db.Decimal
  entry_roundtrip_pct Decimal?  @db.Decimal
  entry_score         Int?      @db.SmallInt
  entry_zone          String?
  features            Json
  model_version       String?
  p_x3                Decimal?  @db.Decimal
  p_dd50              Decimal?  @db.Decimal
  status              String    @default("pending")
  hit_x2              Boolean?
  hit_x3              Boolean?
  hit_x5              Boolean?
  dd50_first          Boolean?
  max_multiple_7d     Decimal?  @db.Decimal
  hours_to_x3         Decimal?  @db.Decimal
  observed_hours      Decimal?  @db.Decimal
  labelled_at         DateTime? @db.Timestamptz(6)
  label_attempts      Int       @default(0) @db.SmallInt
  label_error         String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  hit_sl30            Boolean?
  x2_before_sl30      Boolean?
  sl30_before_x2      Boolean?
  min_multiple_7d     Decimal?  @db.Decimal
  hours_to_x2         Decimal?  @db.Decimal
  entry_dex_id        String?
  next_label_at       DateTime? @db.Timestamptz(6)
  candles_1m_at       DateTime? @db.Timestamptz(6)
  candles_5m_at       DateTime? @db.Timestamptz(6)
  candles_attempts    Int       @default(0) @db.SmallInt
  pair_age_h          Decimal?  @default(dbgenerated("\nCASE\n    WHEN (jsonb_typeof((features -> 'log_age_h'::text)) = 'number'::text) THEN round(((exp(LEAST(GREATEST(((features ->> 'log_age_h'::text))::double precision, (0)::double precision), (12)::double precision)) - (1)::double precision))::numeric, 3)\n    ELSE NULL::numeric\nEND")) @db.Decimal
  tokens              tokens    @relation(fields: [mint], references: [mint], onDelete: Cascade, onUpdate: NoAction)

  @@index([candles_1m_at], map: "signal_outcomes_candles_1m_idx", where: raw("(candles_1m_at IS NOT NULL)"))
  @@index([candles_5m_at], map: "signal_outcomes_candles_5m_idx", where: raw("(candles_5m_at IS NOT NULL)"))
  @@index([next_label_at], map: "signal_outcomes_next_label_idx", where: raw("(status = 'pending'::text)"))
  @@index([labelled_at, detected_at], map: "signal_outcomes_pending_queue_idx", where: raw("(status = 'pending'::text)"))
  @@index([status, detected_at(sort: Desc)], map: "signal_outcomes_status_detected_idx")
}

/// Instantanés de collecte (≈ 115 000 / jour), purge 3 j / 30 j (job purge). score / zone_status gardés : lus par x3_backfill_candidates.
model token_snapshots {
  id                        BigInt   @id @default(autoincrement())
  mint                      String
  captured_at               DateTime @default(now()) @db.Timestamptz(6)
  price_usd                 Decimal  @db.Decimal
  market_cap                Decimal  @db.Decimal
  liquidity_usd             Decimal  @db.Decimal
  volume_24h                Decimal  @db.Decimal
  score                     Int?     @db.SmallInt
  zone_status               String?
  holder_count              Int?
  volume_1h                 Decimal? @db.Decimal
  txns_1h                   Int?
  dex_id                    String?
  organic_score             Decimal? @db.Decimal
  source                    String   @default("scan")
  mint_authority_disabled   Boolean?
  freeze_authority_disabled Boolean?
  top10_pct                 Decimal? @db.Decimal
  insiders_detected         Boolean?
  roundtrip_cost_pct        Decimal? @db.Decimal
  change_1h                 Decimal? @db.Decimal
  buys_1h                   Int?
  sells_1h                  Int?
  liquidity_effective_usd   Decimal? @db.Decimal
  lp_locked_pct             Decimal? @db.Decimal
  tokens                    tokens   @relation(fields: [mint], references: [mint], onDelete: Cascade, onUpdate: NoAction)

  @@index([mint, captured_at(sort: Desc)], map: "token_snapshots_mint_time_idx")
  @@index([captured_at, id], map: "token_snapshots_time_id_idx")
  @@index([captured_at], map: "token_snapshots_time_idx")
}

/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
/// Tokens suivis (scan-tokens, enrich-tokens). Colonnes archivées du 21/11 retirées sauf liquidity_jup_usd (lue par le front).
model tokens {
  mint                      String            @id
  symbol                    String
  name                      String            @default("")
  pair_address              String
  dex_id                    String            @default("")
  image_url                 String?
  website_url               String?
  x_url                     String?
  telegram_url              String?
  price_usd                 Decimal           @db.Decimal
  market_cap                Decimal           @db.Decimal
  liquidity_usd             Decimal           @db.Decimal
  volume_24h                Decimal           @db.Decimal
  change_5m                 Decimal           @default(0) @db.Decimal
  change_1h                 Decimal           @default(0) @db.Decimal
  change_6h                 Decimal           @default(0) @db.Decimal
  change_24h                Decimal           @default(0) @db.Decimal
  buys_1h                   Int               @default(0)
  sells_1h                  Int               @default(0)
  buys_24h                  Int               @default(0)
  sells_24h                 Int               @default(0)
  pair_created_at           DateTime?         @db.Timestamptz(6)
  flags                     String[]          @default([])
  mint_authority_disabled   Boolean?
  freeze_authority_disabled Boolean?
  top10_pct                 Decimal?          @db.Decimal
  holder_count              Int?
  organic_score             Decimal?          @db.Decimal
  first_seen_at             DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                DateTime          @default(now()) @db.Timestamptz(6)
  liquidity_jup_usd         Decimal?          @db.Decimal
  liquidity_dex_usd         Decimal?          @default(dbgenerated("liquidity_usd")) @db.Decimal
  liquidity_gecko_usd       Decimal?          @db.Decimal
  liquidity_effective_usd   Decimal?          @db.Decimal
  liquidity_divergence      Decimal?          @db.Decimal
  roundtrip_cost_pct        Decimal?          @db.Decimal
  roundtrip_fee_pct         Decimal?          @db.Decimal
  buy_impact_pct            Decimal?          @db.Decimal
  lp_locked_pct             Decimal?          @db.Decimal
  rugcheck_score            Decimal?          @db.Decimal
  rugcheck_dangers          String[]          @default([])
  price_jup_usd             Decimal?          @db.Decimal
  price_gecko_usd           Decimal?          @db.Decimal
  data_confidence           String?
  quote_at                  DateTime?         @db.Timestamptz(6)
  rugcheck_at               DateTime?         @db.Timestamptz(6)
  enriched_at               DateTime?         @db.Timestamptz(6)
  narrative                 String?
  narrative_rank            Int?              @db.SmallInt
  features                  Json?
  insiders_detected         Boolean?
  creator_rug_history       Boolean?
  sources                   String[]          @default([])
  spark_6h                  Float[]           @db.Real
  volume_1h                 Decimal?          @db.Decimal
  signal_outcomes           signal_outcomes?
  token_snapshots           token_snapshots[]

  @@index([pair_created_at(sort: Desc)])
  @@index([sources], type: Gin)
  @@index([updated_at(sort: Desc)])
}

/// Rejeu d'une variante contre la référence (rapport replayVariants en JSON).
model variant_replays {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variant_id        String
  fingerprint       String
  reference_version String
  variant_version   String
  period_from       DateTime        @db.Timestamptz(6)
  period_to         DateTime        @db.Timestamptz(6)
  records           Int
  skipped_records   Int             @default(0)
  report            Json
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  engine_variants   engine_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variant_id, created_at(sort: Desc)], map: "variant_replays_variant_created_idx")
}

/// Verdict du moteur enregistré par le banc (§16.1), unique par (mint, engine_version).
model verdict_records {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mint                   String
  verdict_at             DateTime                 @db.Timestamptz(6)
  engine_version         String
  verdict                String
  reason_codes           String[]                 @default([])
  flagged_checks         String[]                 @default([])
  baseline_price_usd     Decimal?                 @db.Decimal
  baseline_liquidity_usd Decimal?                 @db.Decimal
  baseline_supply_raw    Decimal?                 @db.Decimal(20, 0)
  facts                  Json
  facts_version          String
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  follow_up_observations follow_up_observations[]

  @@unique([mint, engine_version], map: "verdict_records_mint_engine_key")
  @@index([engine_version, verdict_at], map: "verdict_records_engine_verdict_at_idx")
  @@index([verdict_at])
}

model wallet_study_budget {
