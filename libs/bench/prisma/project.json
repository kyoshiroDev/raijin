{
  "name": "bench-prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bench/prisma/src",
  "projectType": "library",
  "tags": ["scope:bench", "type:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/bench/prisma",
        "tsConfig": "libs/bench/prisma/tsconfig.lib.json",
        "packageJson": "libs/bench/prisma/package.json",
        "main": "libs/bench/prisma/src/index.ts",
        "assets": [
          "libs/bench/prisma/*.md",
          {
            "input": "libs/bench/prisma/prisma",
            "glob": "**/*",
            "output": "prisma"
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/bench/prisma",
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts",
        { "externalDependencies": ["prisma", "@prisma/client"] }
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "prisma generate"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "prisma migrate deploy"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "prisma migrate deploy"
      }
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "prisma migrate dev"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "prisma migrate status"
      }
    },
    "migrate-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "bash scripts/check-migrations.sh"
      }
    },
    "test-db": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["prisma-generate"],
      "options": {
        "cwd": "libs/bench/prisma",
        "command": "jest -c jest.db.config.cts --runInBand"
      }
    }
  }
}
