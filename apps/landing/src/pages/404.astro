---
import Container from '../components/Container.astro';
import RaiMascot from '../components/RaiMascot.astro';
import Base from '../layouts/Base.astro';
import { STATIC_PAGES } from '../lib/pages';

const page = STATIC_PAGES.notFound;
---

<Base title={page.title} description={page.description} path={page.path} og={page.og} noindex>
  <Container
    narrow
    class="flex flex-col items-center py-16 text-center md:py-24 [@media(max-height:500px)]:flex-row [@media(max-height:500px)]:justify-center [@media(max-height:500px)]:gap-6 [@media(max-height:500px)]:py-6 [@media(max-height:500px)]:text-left"
  >
    <RaiMascot pose="bravo" class="size-40 shrink-0 md:size-52 [@media(max-height:500px)]:size-28" />
    <div class="flex flex-col items-center [@media(max-height:500px)]:items-start">
    <h1 class="mt-6 font-display [@media(max-height:500px)]:mt-0 text-h1 font-bold text-ink">Page introuvable</h1>
    <p class="mt-3 max-w-md text-body text-ink-muted">
      Cette page n'existe pas ou a été déplacée. Rien de grave : Rai garde le reste du site.
    </p>
    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-thunder px-6 text-body font-semibold text-on-thunder transition-shadow hover:shadow-glow focus-visible:shadow-glow"
      >
        Retour à l'accueil
      </a>
      <a
        href="/guides"
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-line-strong px-6 text-body font-semibold text-ink transition-colors hover:border-ink-muted"
      >
        Lire les guides
      </a>
    </div>
    </div>
  </Container>
</Base>
