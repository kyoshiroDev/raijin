---
import AnalyseForm from '../components/AnalyseForm.astro';
import ChecksList from '../components/ChecksList.astro';
import Container from '../components/Container.astro';
import CtaFinal from '../components/CtaFinal.astro';
import DemoAnalysis from '../components/DemoAnalysis.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PricingCards from '../components/PricingCards.astro';
import RaiMascot from '../components/RaiMascot.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import VerdictsExplained from '../components/VerdictsExplained.astro';
import Base from '../layouts/Base.astro';
import { APP_ROUTES, appHref } from '../lib/app-url';
import { getFaq } from '../lib/collections';
import { DEMO } from '../lib/demo/demo';
import { STATIC_PAGES } from '../lib/pages';
import { PRICING } from '../lib/pricing';
import { faqPageLd, organizationLd, softwareApplicationLd } from '../lib/seo';

const page = STATIC_PAGES.home;
const faq = await getFaq({ homeOnly: true });
const offers = [
  { name: 'Gratuit', priceCents: 0, currency: PRICING.pro.currency },
  { name: 'Pro mensuel', priceCents: PRICING.pro.monthlyCents, currency: PRICING.pro.currency },
  { name: 'Pro annuel', priceCents: PRICING.pro.yearlyCents, currency: PRICING.pro.currency },
];
const jsonLd = [organizationLd(), softwareApplicationLd(page.description, offers), faqPageLd(faq)];
const heroChecks = [
  ...DEMO.checks.filter((check) => check.status !== 'ok'),
  ...DEMO.checks.filter((check) => check.status === 'ok').slice(0, 2),
];
const section = 'py-12 md:py-16';
const h2 = 'font-display text-h2 font-bold text-ink md:text-h1';
---

<Base title={page.title} description={page.description} path={page.path} og={page.og} jsonLd={jsonLd}>
  <section aria-labelledby="hero-title" class="border-b border-line">
    <Container class="py-10 md:py-16 [@media(max-height:500px)]:py-6">
      <div class="flex min-w-0 flex-col items-center text-center md:flex-row md:items-center md:gap-8 md:text-left">
        <RaiMascot
          pose="hero"
          animated
          alt="Rai, le gardien de Raijin, bouclier en avant"
          class="size-40 shrink-0 md:order-2 md:size-56 lg:size-72 [@media(max-height:500px)]:size-24"
        />
        <div class="mt-4 min-w-0 md:order-1 md:mt-0">
          <p class="text-body-sm font-semibold uppercase text-thunder-ink">Raijin Shield</p>
          <h1 id="hero-title" class="mt-2 font-display text-h1 font-bold text-ink md:text-display">
            Vérifie avant de signer.
          </h1>
          <p class="mt-4 text-body text-ink-muted md:text-h3">
            Le bouclier anti-rug des memecoins Solana. Colle l'adresse d'un token&nbsp;: Raijin vérifie 9 points de sécurité
            et te donne un verdict clair, avec ses sources.
          </p>
          <div class="mt-6 text-left">
            <AnalyseForm id="hero" anonAnalysesPerDay={PRICING.anonAnalysesPerDay} />
          </div>
          <div class="mt-2 text-left text-body-sm text-ink">
            <p>{PRICING.trialOffer}</p>
            <a
              href={appHref(APP_ROUTES.inscription)}
              data-app-link
              data-track="cta_essai_clic"
              data-track-emplacement="hero"
              class="flex min-h-11 w-fit items-center font-semibold underline decoration-thunder decoration-2 underline-offset-4"
            >
              Créer mon compte
            </a>
          </div>
        </div>
      </div>
    </Container>
    <Container class="pb-10 md:pb-16">
      <figure class="mx-auto max-w-2xl rounded-lg border border-line bg-surface p-4 shadow-card md:p-6">
        <figcaption class="text-label text-ink-muted">Aperçu d'un résultat · token fictif « {DEMO.tokenName} »</figcaption>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <VerdictBadge verdict={DEMO.verdict} />
          <p class="text-body-sm text-ink">{DEMO.explanation}</p>
        </div>
        <ul class="mt-3 space-y-1">
          {
            heroChecks.map((check) => (
              <li class="flex items-center justify-between gap-3 text-body-sm">
                <span class="truncate text-ink">{check.label}</span>
                <span class="shrink-0 text-ink-muted">{check.statusLabel}</span>
              </li>
            ))
          }
        </ul>
      </figure>
    </Container>
  </section>

  <section aria-labelledby="verdicts-title" class={section}>
    <Container>
      <h2 id="verdicts-title" class={h2}>Trois verdicts, zéro jargon</h2>
      <p class="mt-3 max-w-2xl text-body text-ink-muted">
        Des règles publiques et déterministes, pas d'« IA magique ». Chaque verdict s'affiche avec une icône et un mot.
      </p>
      <div class="mt-8">
        <VerdictsExplained />
      </div>
    </Container>
  </section>

  <section aria-labelledby="controles-title" class={`${section} border-t border-line`}>
    <Container>
      <h2 id="controles-title" class={h2}>Les 9 contrôles de chaque analyse</h2>
      <p class="mt-3 max-w-2xl text-body text-ink-muted">
        Chaque contrôle a un statut (OK, Attention, Danger ou Indisponible) et cite sa source. Rien n'est signé, rien
        n'est exécuté : Raijin lit seulement des données publiques.
      </p>
      <div class="mt-8">
        <ChecksList headingLevel="p" />
      </div>
      <a
        href="/comment-ca-marche"
        class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink underline decoration-thunder decoration-2 underline-offset-4"
      >
        Comment Raijin décide du verdict
        <Icon name="arrowRight" size={18} />
      </a>
    </Container>
  </section>

  <section aria-labelledby="demo-title" class={`${section} border-t border-line`}>
    <Container narrow>
      <h2 id="demo-title" class={h2}>La preuve par l'exemple</h2>
      <p class="mt-3 text-body text-ink-muted">
        Une analyse de démonstration, calculée par le même moteur que l'app, sur un token fictif.
      </p>
      <div class="mt-8">
        <DemoAnalysis />
      </div>
    </Container>
  </section>

  <section id="tarifs" aria-labelledby="tarifs-title" class={`${section} border-t border-line`}>
    <Container>
      <h2 id="tarifs-title" class={h2}>Tarifs simples</h2>
      <p class="mt-3 max-w-2xl text-body text-ink-muted">{PRICING.trialOffer}</p>
      <div class="mt-8">
        <PricingCards />
      </div>
      <a
        href="/tarifs"
        data-track="voir_tarifs"
        class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink underline decoration-thunder decoration-2 underline-offset-4"
      >
        Comparer les plans en détail
        <Icon name="arrowRight" size={18} />
      </a>
    </Container>
  </section>

  <section aria-labelledby="faq-title" class={`${section} border-t border-line`}>
    <Container narrow>
      <h2 id="faq-title" class={h2}>Questions fréquentes</h2>
      <div class="mt-8">
        <FaqList items={faq} />
      </div>
      <a
        href="/faq"
        class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink underline decoration-thunder decoration-2 underline-offset-4"
      >
        Toutes les questions
        <Icon name="arrowRight" size={18} />
      </a>
    </Container>
  </section>

  <div class={`${section} border-t border-line`}>
    <Container>
      <CtaFinal />
    </Container>
  </div>
</Base>
