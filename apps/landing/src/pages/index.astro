---
import Base from '../layouts/Base.astro';
import { appHref } from '../lib/app-url';
---

<Base
  title="Raijin Shield — le bouclier anti-rug des memecoins Solana"
  description="Colle l'adresse d'un token Solana et obtiens un verdict clair et sourcé : Sain, Prudence ou Danger."
>
  <main class="mx-auto max-w-reading px-4 py-10 md:px-6 lg:px-8">
    <h1 class="font-display text-h1 md:text-display">Vérifie avant de signer.</h1>
    <p class="mt-4 text-body text-ink-muted">Raijin Shield, le bouclier anti-rug des memecoins Solana.</p>
    <a
      href={appHref('/inscription')}
      data-app-link
      data-track="cta_essai_clic"
      data-track-emplacement="hero"
      class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-thunder px-6 text-body font-semibold text-on-thunder transition-shadow hover:shadow-glow"
    >
      Essayer Raijin
    </a>
  </main>
</Base>
