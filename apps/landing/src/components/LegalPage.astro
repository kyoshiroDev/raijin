---
import Base from '../layouts/Base.astro';
import { pageCrumbs } from '../lib/breadcrumbs';
import { LEGAL_UPDATED_AT } from '../lib/content';
import { STATIC_PAGES, type StaticPageKey } from '../lib/pages';
import { breadcrumbLd } from '../lib/seo';
import Container from './Container.astro';
import PageIntro from './PageIntro.astro';

/** Gabarit des pages légales : intro, date de mise à jour, contenu éditorial (`.prose`). */
interface Props {
  page: Extract<StaticPageKey, 'mentionsLegales' | 'cgu' | 'confidentialite'>;
  title: string;
  lead: string;
}

const { page: key, title, lead } = Astro.props;
const page = STATIC_PAGES[key];
const crumbs = pageCrumbs(key);
const updated = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(LEGAL_UPDATED_AT);
---

<Base title={page.title} description={page.description} path={page.path} og={page.og} jsonLd={[breadcrumbLd(crumbs)]}>
  <PageIntro crumbs={crumbs} title={title} lead={lead} narrow>
    <p class="mt-4 text-body-sm text-ink-muted">
      Dernière mise à jour : <time datetime={LEGAL_UPDATED_AT.toISOString()}>{updated}</time>
    </p>
  </PageIntro>
  <Container narrow class="py-10 md:py-14">
    <div class="prose">
      <slot />
    </div>
  </Container>
</Base>
