---
/** Conteneur de lecture (PROMPT.md §3) : 1200 px max, marges 16 / 24 / 32 px. */
interface Props {
  class?: string;
  narrow?: boolean;
}

const { class: className, narrow = false } = Astro.props;
---

<div class:list={['mx-auto px-4 md:px-6 lg:px-8', narrow ? 'max-w-3xl' : 'max-w-reading', className]}>
  <slot />
</div>
