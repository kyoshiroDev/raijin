{
  "name": "landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/landing/src",
  "tags": ["scope:landing", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/libs/brand/**/*"
      ],
      "outputs": ["{workspaceRoot}/dist/apps/landing"],
      "options": {
        "cwd": "apps/landing",
        "command": "astro build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/landing",
        "command": "astro dev --port 4321"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/landing",
        "command": "astro preview --port 4321"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/landing",
        "command": "astro check --minimumFailingSeverity warning"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/landing",
        "command": "vitest run"
      },
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "{workspaceRoot}/libs/brand/**/*"]
    }
  }
}
