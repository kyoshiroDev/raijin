{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "scope:api",
    "type:app"
  ],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "dev-infra": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose -p raijin-dev -f docker-compose.dev.yml up -d --wait"
      }
    },
    "dev-infra-stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker compose -p raijin-dev -f docker-compose.dev.yml stop"
      }
    },
    "serve-e2e": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node dist/apps/api/main.js",
        "readyWhen": "API Raijin",
        "env": {
          "ANALYSIS_FIXTURES": "1",
          "TRUST_PROXY": "1",
          "NODE_ENV": "development",
          "API_PORT": "3200",
          "JOBS_TEST_TRIGGER": "1",
          "PUSH_PROVIDER": "fake",
          "ALERT_EMAIL_BATCH_DELAY_S": "1",
          "BULLMQ_PREFIX": "raijin-e2e"
        }
      }
    },
    "make-admin": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node dist/apps/api/cli.js make-admin"
      }
    },
    "admin-reset-2fa": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node dist/apps/api/cli.js admin-reset-2fa"
      }
    }
  }
}
