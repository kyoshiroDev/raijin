{
  "name": "raijin-banc-de-test",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/raijin-banc-de-test/src",
  "tags": ["scope:bench", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/raijin-banc-de-test",
        "browser": "apps/raijin-banc-de-test/src/main.ts",
        "tsConfig": "apps/raijin-banc-de-test/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/raijin-banc-de-test/public" }],
        "styles": ["apps/raijin-banc-de-test/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "600kb", "maximumError": "1mb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": false },
            "fonts": true
          },
          "serviceWorker": "apps/raijin-banc-de-test/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "local": {
          "fileReplacements": [
            {
              "replace": "apps/raijin-banc-de-test/src/environments/environment.ts",
              "with": "apps/raijin-banc-de-test/src/environments/environment.local.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": { "port": 4300 },
      "configurations": {
        "production": { "buildTarget": "raijin-banc-de-test:build:production" },
        "development": { "buildTarget": "raijin-banc-de-test:build:development" },
        "local": { "buildTarget": "raijin-banc-de-test:build:local" }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": { "watch": false }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/raijin-banc-de-test",
        "commands": ["tsc --noEmit -p tsconfig.app.json", "tsc --noEmit -p tsconfig.spec.json"],
        "parallel": false
      }
    },
    "write-env": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/raijin-banc-de-test",
        "command": "node scripts/write-env.mjs"
      }
    }
  }
}
