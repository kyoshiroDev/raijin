{
  "name": "raijin-banc-de-test-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/raijin-banc-de-test-api/src",
  "projectType": "application",
  "tags": [
    "scope:bench",
    "type:app"
  ],
  "targets": {
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/package.json",
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/patches",
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/raijin-banc-de-test-api/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "raijin-banc-de-test-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "raijin-banc-de-test-api:build:development"
        },
        "production": {
          "buildTarget": "raijin-banc-de-test-api:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/raijin-banc-de-test-api",
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "create-owner": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/raijin-banc-de-test-api/cli.js create-owner"
      }
    },
    "set-password": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/raijin-banc-de-test-api/cli.js set-password"
      }
    },
    "reset-2fa": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/raijin-banc-de-test-api/cli.js reset-2fa"
      }
    }
  }
}
