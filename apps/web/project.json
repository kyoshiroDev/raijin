{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "rj",
  "sourceRoot": "apps/web/src",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          },
          {
            "glob": "*.{svg,png}",
            "input": "libs/brand/icons",
            "output": "icons"
          },
          {
            "glob": "*.svg",
            "input": "libs/brand/mascot",
            "output": "brand/mascot"
          },
          {
            "glob": "inter-latin-{400,500,600}-normal.woff2",
            "input": "node_modules/@fontsource/inter/files",
            "output": "fonts"
          },
          {
            "glob": "space-grotesk-latin-{600,700}-normal.woff2",
            "input": "node_modules/@fontsource/space-grotesk/files",
            "output": "fonts"
          },
          {
            "glob": "jetbrains-mono-latin-{500,600}-normal.woff2",
            "input": "node_modules/@fontsource/jetbrains-mono/files",
            "output": "fonts"
          }
        ],
        "styles": [
          "apps/web/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "400kb",
              "maximumError": "500kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/web/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      },
      "dependsOn": [
        "check-brand-png"
      ]
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "commands": [
          "tsc --noEmit -p tsconfig.app.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "render-mascot-png": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/render-mascot-png.mjs"
      }
    },
    "check-brand-png": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/brand/mascot/*.svg",
        "{workspaceRoot}/libs/brand/logos/raijin-mark.svg",
        "{projectRoot}/public/email/*.png",
        "{projectRoot}/public/icons/*.png",
        "{projectRoot}/brand-png.lock.json",
        "{workspaceRoot}/tools/scripts/render-mascot-png.mjs",
        "{projectRoot}/public/maintenance-static.css",
        "{workspaceRoot}/libs/brand/tokens.css"
      ],
      "options": {
        "command": "node tools/scripts/render-mascot-png.mjs --check"
      }
    }
  }
}
