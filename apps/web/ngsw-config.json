{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "mascot",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/brand/mascot/rai-alerte.svg", "/brand/mascot/rai-bravo.svg"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/fonts/**", "/brand/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/t/**", "!/email/**"],
  "navigationRequestStrategy": "performance"
}
