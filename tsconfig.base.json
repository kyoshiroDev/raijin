{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@raijin/shared-contracts": ["./libs/shared/contracts/src/index.ts"],
      "@raijin/shared-util": ["./libs/shared/util/src/index.ts"],
      "@raijin/shared-risk-engine": ["./libs/shared/risk-engine/src/index.ts"],
      "@raijin/web-ui": ["./libs/web/ui/src/index.ts"],
      "@raijin/web-data-access": ["./libs/web/data-access/src/index.ts"],
      "@raijin/web-feature-analyse": [
        "./libs/web/feature-analyse/src/index.ts"
      ],
      "@raijin/web-feature-suivis": ["./libs/web/feature-suivis/src/index.ts"],
      "@raijin/web-feature-wallet": ["./libs/web/feature-wallet/src/index.ts"],
      "@raijin/web-feature-compte": ["./libs/web/feature-compte/src/index.ts"],
      "@raijin/api-auth": ["./libs/api/auth/src/index.ts"],
      "@raijin/api-users": ["./libs/api/users/src/index.ts"],
      "@raijin/api-billing": ["./libs/api/billing/src/index.ts"],
      "@raijin/api-alerts": ["./libs/api/alerts/src/index.ts"],
      "@raijin/api-notifications": ["./libs/api/notifications/src/index.ts"],
      "@raijin/api-solana": ["./libs/api/solana/src/index.ts"],
      "@raijin/api-solana/testing": ["./libs/api/solana/src/testing.ts"],
      "@raijin/api-prisma": ["./libs/api/prisma/src/index.ts"],
      "@raijin/api-core": ["./libs/api/core/src/index.ts"],
      "@raijin/api-analysis": ["./libs/api/analysis/src/index.ts"],
      "@raijin/api-wallet": ["./libs/api/wallet/src/index.ts"],
      "@raijin/api-trial": ["./libs/api/trial/src/index.ts"],
      "@raijin/api-admin": ["./libs/api/admin/src/index.ts"],
      "@raijin/api-analytics": ["./libs/api/analytics/src/index.ts"],
      "@raijin/web-feature-admin": ["./libs/web/feature-admin/src/index.ts"],
      "@raijin/bench-verdicts": ["./libs/bench/verdicts/src/index.ts"],
      "@raijin/bench-contracts": ["./libs/bench/contracts/src/index.ts"],
      "@raijin/server-push": ["./libs/server/push/src/index.ts"],
      "@raijin/server-security": ["./libs/server/security/src/index.ts"],
      "@raijin/bench-solana": ["./libs/bench/solana/src/index.ts"],
      "@raijin/bench-prisma": ["./libs/bench/prisma/src/index.ts"],
      "@raijin/bench-core": ["./libs/bench/core/src/index.ts"],
      "@raijin/bench-engine": ["./libs/bench/engine/src/index.ts"],
      "@raijin/bench-collect": ["./libs/bench/collect/src/index.ts"],
      "@raijin/bench-trading": ["./libs/bench/trading/src/index.ts"],
