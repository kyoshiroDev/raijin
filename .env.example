# =====================================================================
# Raijin Shield — modèle de .env (VALEURS FACTICES, commité). Copie-le en .env puis remplis.
# Une ligne de commentaire par variable : à quoi elle sert, [obligatoire, secret…], où l’obtenir.
# Détail complet : docs/ENV.md. Modèle : tools/env/env-schema.mjs.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Base, Redis et adresses
# ---------------------------------------------------------------------
# Mode d'exécution (development sur ta machine)
NODE_ENV=development
# Adresse de la base PostgreSQL locale (docker-compose.dev.yml, port 5433) [secret]
DATABASE_URL=
# Adresse du Redis local (port 6380)
REDIS_URL=redis://localhost:6380
# Utilisateur du Postgres local
POSTGRES_USER=raijin
# Mot de passe du Postgres local (le même que dans DATABASE_URL) [secret] — openssl rand -base64 32
POSTGRES_PASSWORD=changeme-factice
# Nom de la base locale
POSTGRES_DB=raijin
# Adresse de l'app (prod : https://app.raijinshield.com)
APP_URL=http://localhost:4200
# Adresse de la landing (prod : https://raijinshield.com)
LANDING_URL=http://localhost:4321
# Adresse de l'API (prod : https://api.raijinshield.com)
API_URL=http://localhost:3100
# Port de l'API sur ta machine (3000 est pris par d'autres projets)
API_PORT=3100
# Origines autorisées (app + landing), séparées par des virgules
CORS_ORIGINS=http://localhost:4200,http://localhost:4321

# ---------------------------------------------------------------------
# 2. Sécurité (secrets générés)
# ---------------------------------------------------------------------
# Signature des sessions (vide sur ta machine = généré à chaque démarrage) [secret] — openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret-factice
# Signature des jetons anti-CSRF [secret] — openssl rand -base64 32
COOKIE_SECRET=changeme-cookie-secret-factice
# Empreinte des IP des visiteurs anonymes (quota) [secret] — openssl rand -base64 48
IP_HASH_SECRET=changeme-ip-hash-secret-factice
# Chiffrement de la 2FA admin (32 octets en base64) [secret] — openssl rand -base64 32
TOTP_ENCRYPTION_KEY=changeme-cle-totp-factice
# Clé publique des notifications push (paire propre à chaque environnement) — pnpm exec web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
# Clé privée des notifications push (avec la clé publique, jamais seule) [secret] — pnpm exec web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=
# Contact exigé par les services push (mailto: ou https:)
VAPID_SUBJECT=mailto:support@raijinshield.com

# ---------------------------------------------------------------------
# 3. Helius (données Solana)
# ---------------------------------------------------------------------
# Clé Helius (sans clé sur ta machine : RPC public et simulations) [secret] — https://dashboard.helius.dev/api-keys
HELIUS_API_KEY=
# Crédits Helius par jour pour l'API (bas en dev) — https://www.helius.dev/docs/billing/credits
HELIUS_DAILY_CREDIT_BUDGET=22000
# Part des crédits Helius réservée aux suivis — https://www.helius.dev/docs/billing/credits
WATCH_DAILY_CREDIT_BUDGET=12000
# Part des crédits Helius réservée aux scans de wallet — https://www.helius.dev/docs/billing/credits
WALLET_DAILY_CREDIT_BUDGET=3000

# ---------------------------------------------------------------------
# 4. Google (GA4, Search Console)
# ---------------------------------------------------------------------
# ID de flux GA4 « G-… » (landing ; vide = ni GA4 ni bannière) — https://analytics.google.com/ → Administration → Flux de données
GA4_MEASUREMENT_ID=
# Balise HTML Search Console (inutile si vérifié par DNS) — https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# ID numérique de la propriété GA4 (écrans de l’admin) — https://analytics.google.com/ → Administration → Paramètres de la propriété
GA4_PROPERTY_ID=
# Clé JSON du compte de service, sur une ligne (lecture seule) [secret] — https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=
# Propriété Search Console (ex. sc-domain:raijinshield.com) — https://search.google.com/search-console
SEARCH_CONSOLE_SITE_URL=

# ---------------------------------------------------------------------
# 5. Stripe (paiement)
# ---------------------------------------------------------------------
# fake (simulation, ta machine) ou stripe (serveur)
BILLING_PROVIDER=
# Clé secrète Stripe « sk_test_… » (jamais sk_live_ hors prod) [secret] — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret « whsec_… » du webhook (un par environnement) [secret] — https://dashboard.stripe.com/test/webhooks (local : stripe listen)
STRIPE_WEBHOOK_SECRET=
# ID du prix mensuel « price_… » de Raijin Pro (14,90 €) — https://dashboard.stripe.com/test/products
STRIPE_PRICE_PRO_MONTHLY=
# ID du prix annuel « price_… » de Raijin Pro (149 €) — https://dashboard.stripe.com/test/products
STRIPE_PRICE_PRO_YEARLY=

# ---------------------------------------------------------------------
# 6. E-mails
# ---------------------------------------------------------------------
# smtp (Mailpit sur ta machine et en dev) ou resend (prod)
MAIL_PROVIDER=smtp
# Clé Resend d'envoi des e-mails (prod ; dev : capturés par Mailpit) [secret] — https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur (domaine vérifié sur https://resend.com/domains)
MAIL_FROM="Raijin <noreply@raijinshield.com>"
# Serveur SMTP local (Mailpit)
SMTP_HOST=localhost
# Port SMTP local (Mailpit, interface http://localhost:8026)
SMTP_PORT=1026

# ---------------------------------------------------------------------
# 7. Bot Telegram
# ---------------------------------------------------------------------
# Token du bot (dev et prod : deux bots distincts ; vide = bot désactivé) [secret] — https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Identifiant public du bot, sans @
TELEGRAM_BOT_USERNAME=
# Secret du webhook Telegram (en-tête de chaque appel) [secret] — openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Secret partagé bot → API (même valeur des deux côtés) [secret] — openssl rand -hex 32
BOT_SERVICE_TOKEN=
# Hachage des identifiants de chat dans les journaux du bot [secret] — openssl rand -hex 32
BOT_LOG_SALT=

# ---------------------------------------------------------------------
# 8. Radar
# ---------------------------------------------------------------------
# Coupe-circuit du radar : 0 = en pause (vide = actif)
RADAR_ENABLED=

# ---------------------------------------------------------------------
# 9. Sentry (suivi des erreurs, facultatif)
# ---------------------------------------------------------------------
# DSN Sentry de l'API (vide = désactivé) — https://sentry.io/settings/projects/ → Client Keys
SENTRY_DSN_API=
# DSN Sentry de l'app web (vide = désactivé) — https://sentry.io/settings/projects/ → Client Keys
SENTRY_DSN_WEB=
# Nom de l'environnement dans Sentry
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------
# 10. Réglages avancés (optionnel : vide ou absent = valeur par défaut)
# ---------------------------------------------------------------------
# Jobs programmés : réanalyses, alertes, purges (false en dev serveur) — défaut : true
JOBS_ENABLED=true
# webpush (envoi réel) ou fake (tests)
PUSH_PROVIDER=
# Cookies Secure : false sur http://localhost, true en HTTPS — défaut : false
COOKIE_SECURE=false
# Laisser vide (cookies liés à l’hôte de l’API)
COOKIE_DOMAIN=
# Nombre de proxys devant l’API (vide sur ta machine)
TRUST_PROXY=
# Préfixe des files BullMQ dans Redis — défaut : raijin
BULLMQ_PREFIX=raijin
# index.html du build web pour les pages /t/<mint>
WEB_INDEX_HTML_PATH=
# Sources simulées par des fixtures (0 ou 1, refusé en prod) — défaut : 0
ANALYSIS_FIXTURES=0
# Déclenchement manuel des jobs pour les tests (0 ou 1) — défaut : 0
JOBS_TEST_TRIGGER=0
# Dossier des fixtures rejouées
ANALYSIS_FIXTURES_DIR=
# Dossier des polices de l’image Open Graph
OG_FONTS_DIR=
# Mot de passe du compte local dev@raijin.local (vide = généré) [secret]
SEED_USER_PASSWORD=
# Utilisateur SMTP (vide pour Mailpit)
SMTP_USER=
# Mot de passe SMTP (vide pour Mailpit) [secret]
SMTP_PASSWORD=
# Logo PNG des e-mails (vide = APP_URL/icons/icon-192.png)
MAIL_LOGO_URL=
# Base des images des e-mails (vide = APP_URL/email)
MAIL_ASSETS_BASE_URL=
# Clé publiable Stripe : non utilisée, laisser vide
STRIPE_PUBLISHABLE_KEY=
# Configuration « bpc_… » du portail client (vide = défaut)
STRIPE_PORTAL_CONFIGURATION_ID=
# Prix mensuel affiché, en centimes TTC (= prix Stripe) — défaut : 1490
PRO_PRICE_MONTHLY_CENTS=1490
# Prix annuel affiché, en centimes TTC (= prix Stripe) — défaut : 14900
PRO_PRICE_YEARLY_CENTS=14900
# Devise des prix (ISO 4217) — défaut : EUR
BILLING_CURRENCY=EUR
# google ou fake (vide = google si la clé JSON est fournie)
ANALYTICS_PROVIDER=
# Cache des réponses Google (s) — défaut : 3600
ANALYTICS_CACHE_TTL_S=3600
# Débit RPC Helius de l’API (req/s) — défaut : 7
HELIUS_RPC_RPS=7
# Débit DAS Helius de l’API (req/s) — défaut : 1.5
HELIUS_DAS_RPS=1.5
# URL de base Helius (la clé est ajoutée par le code) — défaut : https://mainnet.helius-rpc.com
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# RPC public de repli sans clé — défaut : https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Débit du RPC public (req/s) — défaut : 1
SOLANA_RPC_RPS=1
# URL de l’API DexScreener — défaut : https://api.dexscreener.com
DEXSCREENER_API_URL=https://api.dexscreener.com
# URL de l’API GeckoTerminal — défaut : https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
# URL de l’API de devis Jupiter — défaut : https://lite-api.jup.ag/swap/v1
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# URL de l’API RugCheck — défaut : https://api.rugcheck.xyz/v1
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1
# Requêtes par minute et par IP, toutes routes — défaut : 120
RATE_LIMIT_PER_MINUTE=120
# Requêtes par minute sur /auth (vide = 10 en prod, 60 en dev)
RATE_LIMIT_AUTH_PER_MINUTE=
# Analyses par minute et par IP (vide = 10 en prod, 60 en dev)
RATE_LIMIT_ANALYSIS_PER_MINUTE=
# Sessions de paiement par minute (vide = 10)
RATE_LIMIT_BILLING_PER_MINUTE=
# Scans de wallet par minute (vide = 5 en prod)
RATE_LIMIT_WALLET_SCAN_PER_MINUTE=
# Requêtes admin par minute et par compte — défaut : 60
RATE_LIMIT_ADMIN_PER_MINUTE=60
# Durée de la session courte — défaut : 15m
JWT_ACCESS_TTL=15m
# Durée de la session longue — défaut : 30d
JWT_REFRESH_TTL=30d
# Validité du lien de vérification d’e-mail — défaut : 24h
EMAIL_VERIFY_TTL=24h
# Validité du lien de mot de passe oublié — défaut : 30m
PASSWORD_RESET_TTL=30m
# Validité du lien de connexion — défaut : 15m
MAGIC_LINK_TTL=15m
# Échecs de connexion avant blocage temporaire — défaut : 5
AUTH_LOCKOUT_THRESHOLD=5
# Durée du blocage temporaire — défaut : 15m
AUTH_LOCKOUT_DURATION=15m
# Analyses par jour d’un visiteur anonyme — défaut : 3
ANON_ANALYSIS_DAILY_LIMIT=3
# Analyses par jour du plan Gratuit — défaut : 5
FREE_ANALYSIS_DAILY_LIMIT=5
# Analyses par jour de l’essai Pro — défaut : 50
TRIAL_ANALYSIS_DAILY_LIMIT=50
# Analyses en échec remboursées par jour — défaut : 20
ANALYSIS_FAILED_DAILY_LIMIT=20
# Pannes de sources remboursées par jour — défaut : 10
ANALYSIS_UPSTREAM_FAILED_DAILY_LIMIT=10
# Cache d’un résultat d’analyse (s) — défaut : 60
ANALYSIS_CACHE_TTL_S=60
# Cache d’un résultat sans clé Helius (s) — défaut : 300
ANALYSIS_CACHE_TTL_NO_KEY_S=300
# Durée de l’essai Pro (jours) — défaut : 7
TRIAL_DAYS=7
# Job de fin d’essai (cron UTC)
TRIAL_JOB_CRON=
# Heure d’envoi des e-mails d’essai (Paris)
TRIAL_EMAIL_HOUR=
# Conservation des empreintes d’essai (jours) — défaut : 90
TRIAL_FINGERPRINT_RETENTION_DAYS=90
# Conservation des e-mails ayant eu un essai (jours) — défaut : 730
TRIAL_CLAIM_RETENTION_DAYS=730
# Fenêtre de conversion après l’essai (jours)
TRIAL_CONVERSION_WINDOW_DAYS=
# Suivis actifs du plan Gratuit — défaut : 3
FREE_WATCH_LIMIT=3
# Suivis actifs du Pro et de l’essai — défaut : 50
PRO_WATCH_LIMIT=50
# Historique d’alertes affiché, Gratuit (jours)
FREE_ALERT_HISTORY_DAYS=
# Historique d’alertes affiché, Pro (jours)
PRO_ALERT_HISTORY_DAYS=
# Période du planificateur des réanalyses (s)
WATCH_TICK_SECONDS=
# Passe rapide des suivis (min)
WATCH_FAST_INTERVAL_MIN=
# Passe holders des suivis (min)
WATCH_HOLDERS_INTERVAL_MIN=
# Passe complète des suivis (min)
WATCH_FULL_INTERVAL_MIN=
# Délai minimal entre deux alertes identiques (min)
ALERT_COOLDOWN_MINUTES=
# Regroupement des alertes par e-mail (s)
ALERT_EMAIL_BATCH_DELAY_S=
# E-mails d’alerte au plus par jour
ALERT_EMAIL_DAILY_MAX=
# Rétention des analyses et événements (jours) — défaut : 90
RETENTION_DAYS=90
# Heure de la purge quotidienne (cron UTC)
PURGE_CRON=
# Maintenance : 1 = tout répond 503 sauf /health — défaut : 0
MAINTENANCE_MODE=0
# Scans de wallet par jour, Pro
WALLET_SCAN_DAILY_LIMIT_PRO=
# Scans de wallet par jour, essai Pro
WALLET_SCAN_DAILY_LIMIT_TRIAL=
# Tokens analysés au plus par scan
WALLET_SCAN_MAX_TOKENS=
# Tokens analysés au plus par scan, sans clé Helius
WALLET_SCAN_MAX_TOKENS_NO_KEY=
# Comptes de tokens au-delà desquels le scan est refusé
WALLET_SCAN_MAX_ACCOUNTS=
# Prix demandés au plus par scan
WALLET_SCAN_PRICE_LOOKUP_MAX=
# Seuil « poussière » (USD)
WALLET_SCAN_DUST_USD=
# Échéance d’un scan (ms)
WALLET_SCAN_DEADLINE_MS=
# Cache d’un scan de wallet (s)
WALLET_SCAN_CACHE_TTL_S=
# Cache d’un scan sans clé Helius (s)
WALLET_SCAN_CACHE_TTL_NO_KEY_S=
# Cache du verdict rapide par mint (s)
WALLET_TOKEN_VERDICT_TTL_S=
# Âge maximal d’une analyse réutilisée (s)
WALLET_REUSE_ANALYSIS_MAX_AGE_S=
# Session admin : expiration sans activité (min)
ADMIN_SESSION_IDLE_MINUTES=
# Session admin : durée maximale (h)
ADMIN_SESSION_MAX_HOURS=
# Nom affiché dans l’application d’authentification
ADMIN_TOTP_ISSUER=
# Codes 2FA faux tolérés avant blocage
ADMIN_TOTP_MAX_ATTEMPTS=
# Durée du blocage 2FA (min)
ADMIN_TOTP_LOCKOUT_MINUTES=
# Agrégats nocturnes (cron UTC, avant la purge)
METRICS_CRON=
# Vérification des alertes admin (cron UTC)
ADMIN_ALERTS_CRON=
# Échecs de job de suite avant alerte admin
ADMIN_ALERT_JOB_FAILURES=
# Ratio de quota au-delà duquel alerter
ADMIN_ALERT_QUOTA_RATIO=
# Plafond d’appels Jupiter par jour (vide = sans ratio)
JUPITER_DAILY_CALL_BUDGET=
# Plafond d’appels RugCheck par jour (vide = sans ratio)
RUGCHECK_DAILY_CALL_BUDGET=
# Conservation du journal d’audit (jours)
AUDIT_LOG_RETENTION_DAYS=
# Radar : période de découverte (s) — défaut : 120
RADAR_DISCOVER_SECONDS=120
# Radar : période des contrôles (s) — défaut : 60
RADAR_CHECK_SECONDS=60
# Radar : contrôles par passe — défaut : 4
RADAR_CHECKS_PER_TICK=4
# Radar : nouvelles entrées par heure — défaut : 60
RADAR_MAX_NEW_PER_HOUR=60
# Radar : recontrôles après découverte (min) — défaut : 60,360
RADAR_RECHECK_AFTER_MINUTES=60,360
# Radar : fenêtre affichée (h) — défaut : 24
RADAR_WINDOW_HOURS=24
# Radar : rafraîchissement annoncé (min) — défaut : 5
RADAR_REFRESH_MINUTES=5
# Radar : rapports RugCheck par minute — défaut : 6
RADAR_RUGCHECK_PER_MIN=6
# Radar : rétention des entrées (jours) — défaut : 7
RADAR_RETENTION_DAYS=7
# Bot : polling (ta machine), webhook (prod) ou fake
BOT_TRANSPORT=
# Bot : URL publique du webhook (prod)
BOT_WEBHOOK_URL=
# Bot : racine de l’API Bot (vide = officielle)
TELEGRAM_API_ROOT=
# Bot : port d’écoute — défaut : 3300
BOT_PORT=3300
# Bot : URL de l’API vue par le bot — défaut : http://localhost:3100/api/v1
RAIJIN_API_INTERNAL_URL=http://localhost:3100/api/v1
# Bot : Redis du bot — défaut : redis://localhost:6380/4
BOT_REDIS_URL=redis://localhost:6380/4
# Bot : préfixe des files — défaut : raijin-bot
BOT_BULLMQ_PREFIX=raijin-bot
# Bot : analyses par heure et par groupe — défaut : 20
BOT_GROUP_ANALYSES_PER_HOUR=20
# Bot : période de réclamation des alertes (s) — défaut : 10
BOT_ALERT_POLL_SECONDS=10
# Bot : travailleur d’alertes (on ou off) — défaut : on
BOT_ALERT_WORKER=on
# Bot : analyses par jour d’un compte non lié — défaut : 5
BOT_UNLINKED_ANALYSES_PER_DAY=5
# Bot : retard des alertes du plan Gratuit (s) — défaut : 600
BOT_FREE_ALERT_DELAY_SECONDS=600
# Bot : requêtes internes par minute et par utilisateur
BOT_RATE_LIMIT_PER_SUBJECT_PER_MINUTE=
